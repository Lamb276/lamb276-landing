{
  "rewrites": [
    { "source": "/campaign", "destination": "https://app.lamb276.org/campaign" },
    { "source": "/campaign/:path*", "destination": "https://app.lamb276.org/campaign/:path*" },

    { "source": "/presale", "destination": "https://app.lamb276.org/presale" },
    { "source": "/presale/:path*", "destination": "https://app.lamb276.org/presale/:path*" },
    { "source": "/_next/:path*", "destination": "https://app.lamb276.org/_next/:path*" },
    { "source": "/api/:path*", "destination": "https://app.lamb276.org/api/:path*" },

    { "source": "/monitoring", "destination": "https://app.lamb276.org/monitoring" },
    { "source": "/monitoring/:path*", "destination": "https://app.lamb276.org/monitoring/:path*" },

    { "source": "/campaign-assets/:path*", "destination": "https://app.lamb276.org/campaign-assets/:path*" },

    { "source": "/((?!campaign|presale).*)", "destination": "/index.html" }
  ]
}
